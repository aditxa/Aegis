# Core / MAX model profile
AEGIS_USE_TRANSFORMERS=false
AEGIS_MAX_PROFILE=false
AEGIS_SENTIMENT_MODELS=ProsusAI/finbert,yiyanghkust/finbert-tone,soleimanian/financial-roberta-large-sentiment
AEGIS_EVENT_MODEL=MoritzLaurer/DeBERTa-v3-base-mnli-fever-anli
AEGIS_MODEL_DEVICE=-1

# Network / sources
AEGIS_REQUEST_TIMEOUT=15
AEGIS_USER_AGENT=AegisSignal-X/1.0 research-prototype contact=your-email@example.com
AEGIS_REDDIT_SUBREDDITS=stocks+investing+wallstreetbets
AEGIS_NEWS_LOOKBACK=6h
AEGIS_GDELT_MAX_RECORDS=75

# Risk / storage
AEGIS_ALERT_THRESHOLD=7.0
AEGIS_SQLITE_PATH=outputs/aegis.db
AEGIS_IMPACT_MODEL_PATH=
AEGIS_IMPACT_TAIL_BLEND=0.45
AEGIS_MARKET_BENCHMARK=SPY
AEGIS_MARKET_INTERVAL=5m
AEGIS_MARKET_RANGE=5d
AEGIS_HAWKES_HALF_LIFE_MIN=45
AEGIS_GRAPH_DIFFUSION=0.30
AEGIS_SOURCE_MIN_QUALITY=0.20
AEGIS_RANDOM_SEED=42
